{
  "name": "opencode",
  "displayName": "opencode",
  "description": "opencode for VS Code",
  "version": "1.4.9",
  "publisher": "sst-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opencode"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:opencode.openTerminal",
    "onCommand:opencode.openNewTerminal",
    "onCommand:opencode.addFilepathToTerminal",
    "onChatParticipant:opencode.chat",
    "onCommand:opencode.applyProposedEdits"
  ],
  "enabledApiProposals": [
    "chatParticipantAdditions"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "opencode.openTerminal",
        "title": "Open opencode",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "opencode.openNewTerminal",
        "title": "Open opencode in new tab",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "opencode.addFilepathToTerminal",
        "title": "Add Filepath to Terminal"
      },
      {
        "command": "opencode.selectChatModel",
        "title": "opencode: Select Chat Model"
      },
      {
        "command": "opencode.applyProposedEdits",
        "title": "opencode: Apply Proposed Edits"
      }
    ],
    "chatParticipants": [
      {
        "id": "opencode.chat",
        "name": "opencode",
        "fullName": "opencode",
        "description": "Generate and review proposed code edits with OpenCode",
        "isSticky": true,
        "commands": [
          {
            "name": "new",
            "description": "Start a new OpenCode propose session"
          }
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "opencode.openNewTerminal",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencode.openTerminal",
        "title": "Run opencode",
        "key": "cmd+escape",
        "mac": "cmd+escape",
        "win": "ctrl+escape",
        "linux": "ctrl+escape"
      },
      {
        "command": "opencode.openNewTerminal",
        "title": "Run opencode",
        "key": "cmd+shift+escape",
        "mac": "cmd+shift+escape",
        "win": "ctrl+shift+escape",
        "linux": "ctrl+shift+escape"
      },
      {
        "command": "opencode.addFilepathToTerminal",
        "title": "opencode: Insert At-Mentioned",
        "key": "cmd+alt+k",
        "mac": "cmd+alt+k",
        "win": "ctrl+alt+K",
        "linux": "ctrl+alt+K"
      }
    ],
    "configuration": {
      "title": "opencode",
      "properties": {
        "opencode.chatModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional OpenCode model override in `provider/model` format (for example: `opencode/gpt-5-nano`). When set, this is used instead of the VS Code chat model picker selection.",
          "scope": "resource"
        },
        "opencode.executionMode": {
          "type": "string",
          "enum": [
            "propose",
            "direct"
          ],
          "default": "propose",
          "markdownDescription": "Controls chat edit behavior. `propose` returns proposed edits. `direct` applies changes to files immediately during agent execution.",
          "scope": "resource"
        },
        "opencode.proposeApplyStrategy": {
          "type": "string",
          "enum": [
            "nativeReview",
            "manualApply"
          ],
          "default": "nativeReview",
          "markdownDescription": "Controls how proposed edits are surfaced when `opencode.executionMode` is `propose`. `nativeReview` uses VS Code chat edit review UI when available. `manualApply` always shows an explicit **Apply proposed edits** button and never auto-attaches native review edits.",
          "scope": "resource"
        },
        "opencode.assumeExternalReviewWhenModeUnknown": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Advanced fallback for VS Code builds where chat mode metadata is unavailable to extensions. When enabled, OpenCode will still attempt native external review in `propose` + `nativeReview` even if mode cannot be detected. In Extension Development Host (F5), this fallback is attempted by default when this setting is not explicitly configured. ⚠️ In non-editing contexts, this may apply edits directly instead of showing per-hunk review.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "build": "bun run compile",
    "compile": "bun run check-types && bun run lint && node esbuild.js",
    "proposed-api:download": "npx @vscode/dts dev",
    "proposed-api:sync": "bun run proposed-api:download && node script/sync-proposed-dts.mjs",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run check-types && bun run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@vscode/dts": "^0.4.1",
    "@types/vscode": "^1.102.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
